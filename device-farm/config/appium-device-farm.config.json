{
  "server": {
    "port": 4723,
    "address": "0.0.0.0",
    "base-path": "/",
    "allow-cors": true,
    "session-override": true,
    "relaxed-security": true,
    "log-level": "info",
    "log-timestamp": true,
    "use-drivers": ["uiautomator2"],
    "use-plugins": ["device-farm"],
    "plugin": {
      "device-farm": {
        "platform": "both",
        "androidDeviceType": "both",
        "iosDeviceType": "both",
        "skipChromeDownload": true,
        "deviceAvailabilityTimeoutMs": 180000,
        "deviceAvailabilityQueryIntervalMs": 5000,
        "maxSessions": 4,
        "remoteConnectionTimeout": 60000,
        "newCommandTimeoutSec": 120,
        "bindHostOrIp": "0.0.0.0",
        "enableDashboard": true
      }
    }
  }
}
